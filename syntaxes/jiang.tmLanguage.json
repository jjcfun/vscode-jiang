{
  "name": "Jiang",
  "scopeName": "source.jiang",
  "fileTypes": [
    "jiang"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#variants"
    },
    {
      "include": "#implicit-layer"
    },
    {
      "include": "#generics"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#types"
    },
    {
      "include": "#members"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jiang",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jiang",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.jiang"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.jiang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.jiang",
              "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.quoted.single.jiang",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.character.begin.jiang"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.character.end.jiang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.jiang",
              "match": "\\\\(?:[\"'\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jiang",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.jiang",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jiang",
          "match": "\\b(?:if|else|while|for|in|is|switch|try|catch|break|continue|return|defer|throw)\\b"
        },
        {
          "name": "keyword.declaration.jiang",
          "match": "\\b(?:import|public|alias|extern|enum|union|struct|record|trait|extend|associated|type|static|new)\\b"
        },
        {
          "name": "constant.language.boolean.jiang",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.jiang",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.optional.some.jiang",
          "match": "\\bsome\\b"
        },
        {
          "name": "variable.language.self.jiang",
          "match": "\\b(?:self|Self)\\b"
        },
        {
          "name": "keyword.operator.inference.jiang",
          "match": "\\b_\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct|enum|union|record|trait|type)\\s*(?:\\([^)]*\\)\\s*)?([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.jiang"
            },
            "2": {
              "name": "entity.name.type.jiang"
            }
          }
        },
        {
          "match": "\\b(associated)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.jiang"
            },
            "2": {
              "name": "entity.name.type.associated.jiang"
            }
          }
        },
        {
          "match": "\\b(import)\\s+([a-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "keyword.declaration.jiang"
            },
            "2": {
              "name": "entity.name.namespace.jiang"
            },
            "3": {
              "name": "keyword.operator.jiang"
            }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "keyword.declaration.jiang"
            },
            "2": {
              "name": "entity.name.type.jiang"
            },
            "3": {
              "name": "punctuation.separator.type-constraint.jiang"
            }
          }
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "match": "\\bnew\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "0": {
              "name": "keyword.declaration.jiang"
            },
            "1": {
              "name": "entity.name.type.jiang"
            }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\{)",
          "name": "entity.name.type.constructor.jiang"
        }
      ]
    },
    "variants": {
      "patterns": [
        {
          "match": "(\\.)(([a-z_][A-Za-z0-9_]*))\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.jiang"
            },
            "2": {
              "name": "constant.other.variant.jiang"
            }
          }
        }
      ]
    },
    "implicit-layer": {
      "patterns": [
        {
          "match": "(\\$)(\\.)([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.jiang"
            },
            "2": {
              "name": "punctuation.accessor.jiang"
            },
            "3": {
              "name": "support.function.implicit.jiang"
            }
          }
        },
        {
          "match": "(\\$)(?=\\b|\\.|\\[)",
          "captures": {
            "1": {
              "name": "keyword.operator.address.jiang"
            }
          }
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "match": "(<)([A-Z][A-Za-z0-9_]*)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.generic.begin.jiang"
            },
            "2": {
              "name": "entity.name.type.type-parameter.jiang"
            },
            "3": {
              "name": "punctuation.definition.generic.end.jiang"
            }
          }
        },
        {
          "match": "(<)([A-Z][A-Za-z0-9_]*(?:\\s*,\\s*[A-Z][A-Za-z0-9_]*)+)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.generic.begin.jiang"
            },
            "2": {
              "name": "entity.name.type.type-parameter.jiang"
            },
            "3": {
              "name": "punctuation.definition.generic.end.jiang"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(init)\\s*(?=\\()",
          "name": "entity.name.function.constructor.jiang"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=<[^>]+>\\s*\\()",
          "name": "entity.name.function.jiang"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.jiang"
        },
        {
          "match": "(\\.|\\?\\.)([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.jiang"
            },
            "2": {
              "name": "entity.name.function.member.jiang"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.jiang",
          "match": "\\b(?:Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float|Float16|Float32|Float64|Double|Bool|Char|Fn|Option)\\b"
        },
        {
          "name": "support.type.unit.jiang",
          "match": "\\(\\)"
        },
        {
          "name": "entity.name.type.type-parameter.jiang",
          "match": "\\b[A-Z]\\b"
        },
        {
          "name": "storage.type.user.jiang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\.|\\?\\.)([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.jiang"
            },
            "2": {
              "name": "variable.other.member.jiang"
            }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "(@)(where)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.jiang"
            },
            "2": {
              "name": "storage.modifier.annotation.where.jiang"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*:",
          "captures": {
            "1": {
              "name": "entity.name.label.jiang"
            }
          }
        },
        {
          "match": "(@)([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.jiang"
            },
            "2": {
              "name": "storage.modifier.annotation.jiang"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.jiang",
          "match": "&&|\\|\\||<<|>>|\\?\\?|\\?\\.|\\.\\.|==|!=|<=|>=|=>|[=+\\-*/%&|^~!?:.$<>@]"
        }
      ]
    }
  }
}
