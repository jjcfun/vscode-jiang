{
  "name": "vscode-jiang",
  "displayName": "Jiang Language",
  "description": "Syntax highlighting and language server support for Jiang.",
  "version": "0.2.0",
  "publisher": "jiang-language",
  "license": "Apache-2.0",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjcfun/vscode-jiang.git"
  },
  "homepage": "https://github.com/jjcfun/vscode-jiang#readme",
  "bugs": {
    "url": "https://github.com/jjcfun/vscode-jiang/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test:integration": "node test/run.js"
  },
  "activationEvents": [
    "onLanguage:jiang"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "jiang",
    "syntax",
    "highlighting",
    "language server"
  ],
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/**",
    "node_modules/**",
    "media/logo.png",
    "media/logo.svg",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jiang",
        "aliases": [
          "Jiang",
          "jiang"
        ],
        "extensions": [
          ".jiang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jiang",
        "scopeName": "source.jiang",
        "path": "./syntaxes/jiang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Jiang",
      "properties": {
        "jiang.serverPath": {
          "type": "string",
          "scope": "resource",
          "default": "jiang",
          "description": "Path to the Jiang CLI executable (for example /opt/jiang/bin/jiang). Leave as jiang to use PATH; a bin directory is also accepted."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2"
  }
}
