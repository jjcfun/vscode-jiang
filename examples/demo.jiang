public trait HasLabel {
    Int label(self);
}

public struct Box: HasLabel {
    Int value;

    init(self, Int value) {
        self.value = value;
        return;
    }

    public Int label(self) {
        return 1;
    }
}

enum HttpStatus {
    ok = 200,
    not_found = 404,
}

enum ResultKind {
    ok,
    err,
}

union [ResultKind] Result {
    Int ok;
    Int err;
}

struct User {
    Int id;
    Int name = 0;
    Bool active! = true;
}

@where(T: HasLabel)
Int score<T>(T item) {
    return item.label();
}

Int main() {
    User user = User(id: 7, name: 9);
    Box box = Box(41);
    Result second = .err(2);
    Int value = if user.active { score(box) } else { 0 };

    return switch (second) {
        .ok(_ item) => item,
        .err(_ code) => value + code,
    };
}
