import math = "std/math.jiang";

public trait HasLabel {
    UInt8[] label();
}

public trait Iterator {
    associated Item;
    Item next();
}

public struct Box<T>: HasLabel {
    T value;

    init(T value) {
        self.value = value;
        return;
    }

    T get() {
        return self.value;
    }

    UInt8[] label() {
        return "box";
    }
}

enum HttpStatus {
    ok = 200,
    not_found = 404,
}

enum ResultKind {
    ok,
    err,
}

union(ResultKind) Result<T> {
    T ok;
    UInt8[] err;
}

record User {
    Int id;
    UInt8[] name = "guest";
    Bool! active = true;
}

@where(T: HasLabel)
Int score<T>(T item) {
    UInt8[] label = item.label();
    return label[0]$.as(Int);
}

Int main() {
    User user = User { id: 7, name: "jiang" };
    Box<Int> box = Box<Int>(41);
    Result<Int> first = .ok(box.get());
    Result<Int> second = .err("boom");

    Int? maybe = user.active ? score(box) : null;
    Int value = maybe ?? return 0;

    switch (second) {
        Result.err => return 1;
        else => {}
    }

    if (maybe is some amount) {
        return switch (HttpStatus.not_found) {
            HttpStatus.ok => { amount }
            HttpStatus.not_found => { value + first.ok }
        };
    }

    return 'x'$.as(Int);
}
